<UserControl x:Class="ClaudeVideoEditor.Views.SetupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="740" Margin="30">
            <DockPanel Margin="0,0,0,14">
                <Button Content="Check Again" DockPanel.Dock="Right" VerticalAlignment="Top" Click="Refresh_Click" />
                <StackPanel>
                    <TextBlock Text="Set up your PC" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="Click Install on anything that isn't ticked yet. Everything comes from its official source, and nothing needs admin rights." />
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <!-- Status icon: empty circle, green tick, red cross or spinner-like dots -->
                                    <TextBlock DockPanel.Dock="Left" Width="30" VerticalAlignment="Top" FontFamily="{StaticResource Icons}" FontSize="20">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xEA3A;" />
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                        <Setter Property="Text" Value="&#xE930;" />
                                                        <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Text" Value="&#xEB90;" />
                                                        <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Working">
                                                        <Setter Property="Text" Value="&#xE895;" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="Install" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Primary}" Margin="12,0,0,0"
                                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}" Click="Install_Click" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="{Binding OptionalLabel}" Style="{StaticResource Secondary}" FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,2" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Blurb}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="30,10,0,0" Tag="key" Loaded="KeyRow_Loaded">
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Hyperlink NavigateUri="https://elevenlabs.io/app/settings/api-keys" RequestNavigate="Link_Navigate">Get a key</Hyperlink>
                                    </TextBlock>
                                    <Button Content="Save" DockPanel.Dock="Right" Margin="8,0,0,0" Click="SaveKey_Click" />
                                    <PasswordBox />
                                </DockPanel>
                                <Expander Header="Details" Margin="30,8,0,0" Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding Log, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource Mono}" FontSize="11" MaxHeight="160"
                                             VerticalScrollBarVisibility="Auto" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
