<UserControl x:Class="ClaudeVideoEditor.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ClaudeVideoEditor.Views">
    <UserControl.Resources>
        <!-- Chat item templates, picked by ChatTemplateSelector -->
        <Style x:Key="Tiny" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <DataTemplate x:Key="UserTemplate">
            <StackPanel HorizontalAlignment="Right" Margin="80,0,0,10">
                <Border Background="{StaticResource Accent}" CornerRadius="14" Padding="12,8">
                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="White" />
                </Border>
                <Button Content="☆ Save prompt" Style="{StaticResource Tiny}" HorizontalAlignment="Right" Margin="0,3,0,0"
                        Click="SavePrompt_Click" Loaded="SaveButton_Loaded" ToolTip="Save to Saved Prompts" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AssistantTemplate">
            <StackPanel HorizontalAlignment="Left" Margin="0,0,80,10">
                <Border Background="{StaticResource Subtle}" CornerRadius="14" Padding="12,8">
                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="6,3,0,0">
                    <Button Content="👍" Style="{StaticResource Tiny}" Click="Like_Click" ToolTip="I like this: tell Claude what to keep doing" />
                    <Button Content="👎" Style="{StaticResource Tiny}" Click="Dislike_Click" ToolTip="I don't like this: tell Claude what to avoid" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ToolTemplate">
            <Expander Margin="2,0,0,8" Opacity="0.75">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Icon" Text="&#xE90F;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,2,6,0" />
                        <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Expander.Header>
                <Border Background="{StaticResource Subtle}" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                    <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource Mono}" FontSize="11" />
                </Border>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="NoticeTemplate">
            <TextBlock Text="{Binding Text}" Style="{StaticResource Secondary}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10" />
        </DataTemplate>
        <DataTemplate x:Key="ErrorTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Bad}" Margin="0,2,8,0" />
                <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}" Foreground="{StaticResource Bad}" MaxWidth="560" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ApprovalTemplate">
            <Border CornerRadius="10" Padding="14" Margin="0,0,40,10" BorderThickness="1" BorderBrush="{StaticResource Warn}" Background="{StaticResource Subtle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Warn}" Margin="0,2,8,0" />
                        <TextBlock Text="Claude wants to run a command" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Border Background="{StaticResource Subtle}" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                        <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource Mono}" FontSize="11" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <WrapPanel Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                        <Button Content="Allow" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="Allow_Click" />
                        <Button Content="{Binding AlwaysLabel}" Margin="0,0,8,0" Click="AlwaysAllow_Click" Loaded="AlwaysButton_Loaded" />
                        <Button Content="Deny" Click="Deny_Click" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ApprovalSummary}" Style="{StaticResource Secondary}" FontSize="12" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <v:ChatTemplateSelector x:Key="ChatSelector"
                                User="{StaticResource UserTemplate}" Assistant="{StaticResource AssistantTemplate}"
                                Tool="{StaticResource ToolTemplate}" Notice="{StaticResource NoticeTemplate}"
                                Error="{StaticResource ErrorTemplate}" Approval="{StaticResource ApprovalTemplate}" />
    </UserControl.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add Folder…" Click="AddFolder_Click" />
                <MenuItem Header="_Prompt Creator" InputGestureText="Ctrl+Shift+P" Click="PromptCreator_Click" />
                <MenuItem Header="Saved Prompts &amp; _My Style" InputGestureText="Ctrl+Shift+L" Click="Library_Click" />
                <Separator />
                <MenuItem Header="_Settings" Click="Settings_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Start Guide" Click="Guide_Click" />
                <MenuItem Header="_Credits &amp; Licenses" Click="Credits_Click" />
                <Separator />
                <MenuItem Header="video-use on GitHub" Tag="https://github.com/browser-use/video-use" Click="Url_Click" />
                <MenuItem Header="Claude Video Editor on GitHub" Tag="https://github.com/ItzGhozt/claude-video-editor" Click="Url_Click" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="440" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0" Margin="10">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="FinishSetupButton" Content="⚠  Finish Setup" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="Settings_Click" />
                    <Button Content="🎙  Prompt Creator" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Padding="10,8" Margin="0,0,0,8" Click="PromptCreator_Click" />
                    <Button Content="☆  Saved Prompts &amp; Style" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="Library_Click" />
                    <Button Content="Add Folder…" HorizontalAlignment="Stretch" Click="AddFolder_Click" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Projects" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="4,0,0,6" />
                <Grid>
                    <ListBox x:Name="ProjectList" SelectionChanged="ProjectList_SelectionChanged" AllowDrop="True" Drop="ProjectList_Drop"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in File Explorer" Click="OpenProjectFolder_Click" />
                                <MenuItem Header="Remove from List" Click="RemoveProject_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock x:Name="NoProjectsHint" Text="Add a folder of footage,&#10;or drop one here" Style="{StaticResource Secondary}"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Subtle}" />

            <!-- Chat -->
            <Grid Grid.Column="2">
                <DockPanel x:Name="ChatPanel">
                    <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Subtle}">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="New Chat" Margin="0,0,8,0" Click="NewChat_Click" />
                                <Button Content="Open Folder" Click="OpenProjectFolder_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="ProjectTitle" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="ProjectSubtitle" Style="{StaticResource Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Composer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12">
                        <WrapPanel x:Name="QuickActions" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="Send_Click"
                                    ToolTip="Send (Enter)" Content="Send" />
                            <Button x:Name="StopButton" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="Stop_Click" ToolTip="Stop" Visibility="Collapsed" Content="Stop" />
                            <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" MinHeight="40" VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="Composer_PreviewKeyDown" TextChanged="Composer_TextChanged" />
                        </DockPanel>
                        <TextBlock Text="Enter sends · Shift+Enter for a new line" Style="{StaticResource Secondary}" FontSize="11" Margin="2,4,0,0" />
                    </StackPanel>

                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <StackPanel>
                            <StackPanel x:Name="EmptyChat" HorizontalAlignment="Center" Margin="0,60,0,0" MaxWidth="400">
                                <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource Icons}" FontSize="40" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center"
                                           Text="Pick a quick action below, drag a clip in from the right, or use the Prompt Creator to talk it through first." />
                            </StackPanel>
                            <ItemsControl x:Name="ChatItems" ItemTemplateSelector="{StaticResource ChatSelector}" />
                            <Border x:Name="LiveBubble" Background="{StaticResource Subtle}" CornerRadius="14" Padding="12,8" Margin="0,0,80,10" HorizontalAlignment="Left">
                                <TextBlock x:Name="LiveText" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel x:Name="WorkingRow" Orientation="Horizontal" Margin="4,0,0,0">
                                <ProgressBar IsIndeterminate="True" Width="60" Height="4" VerticalAlignment="Center" />
                                <TextBlock Text="Working…" Style="{StaticResource Secondary}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- No project selected -->
                <StackPanel x:Name="NoProjectPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                    <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource Icons}" FontSize="44" Opacity="0.5" HorizontalAlignment="Center" />
                    <TextBlock Text="Add a project" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,6" />
                    <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,0,0,14"
                               Text="A project is a folder of footage. Claude works inside the folder you pick." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Add Folder…" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="AddFolder_Click" />
                        <Button Content="Start Guide" Click="Guide_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Subtle}" />

            <!-- Clips -->
            <Grid Grid.Column="4" x:Name="ClipsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,6">
                        <DockPanel x:Name="PlayerControls">
                            <Button x:Name="PlayButton" DockPanel.Dock="Left" Click="Play_Click" Margin="0,0,8,0">
                                <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{StaticResource Icons}" />
                            </Button>
                            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" />
                            <Slider x:Name="Seek" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                    PreviewMouseDown="Seek_MouseDown" PreviewMouseUp="Seek_MouseUp" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0" x:Name="ClipInfo">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Use in Chat" Margin="0,0,6,0" Click="UseInChat_Click" ToolTip="Add this clip's name to your message" />
                                <Button Click="ShowInExplorer_Click" ToolTip="Show in File Explorer">
                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" />
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="ClipName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ClipMeta" Style="{StaticResource Secondary}" FontSize="11" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <Grid Background="Black">
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                      MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" />
                        <StackPanel x:Name="PlayerHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="Gray" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PlayerHintText" Text="Select a clip to preview" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" />
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource Subtle}" />

                <DockPanel Grid.Row="2">
                    <DockPanel DockPanel.Dock="Top" Margin="8">
                        <Button DockPanel.Dock="Right" Click="RefreshClips_Click" ToolTip="Refresh" Margin="6,0,0,0">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" />
                        </Button>
                        <TextBox x:Name="ClipFilter" TextChanged="ClipFilter_TextChanged" ToolTip="Filter clips" />
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="ClipList" SelectionChanged="ClipList_SelectionChanged" BorderThickness="0" Background="Transparent"
                                 PreviewMouseLeftButtonDown="ClipList_MouseDown" PreviewMouseMove="ClipList_MouseMove"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,3">
                                        <Border DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource Icons}" Opacity="0.6" Margin="0,2,8,0" DockPanel.Dock="Left" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}" FontSize="11"
                                                       Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Use in Chat" Click="UseInChat_Click" />
                                    <MenuItem Header="Show in File Explorer" Click="ShowInExplorer_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <TextBlock x:Name="NoClipsHint" Text="No video files here yet" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
